# --- Datos (no versionar datasets crudos/pesados) ---
data/01_raw/*
data/02_intermediate/*
data/03_primary/*
data/04_model_output/*
!data/**/.gitkeep
*.csv
*.xlsx
*.parquet
*.geojson
!app/**/*.geojson
*.shp
*.dbf
*.shx

# --- Modelos serializados ---
*.joblib
*.pkl
models/*.pkl
models/**/*.joblib
models/**/*.pkl

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# --- Secretos / BD local ---
.env
*.db
*.sqlite
*.sqlite3

# --- Node / Expo (mobile) ---
node_modules/
.expo/
dist/
*.log

# --- IDE / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Artefactos derivados pequeños que SÍ se versionan (onboarding) ---
# Se suben al repo para que quien clone pueda correr API/dashboard/app sin
# descargar las fuentes crudas (~112 MB) ni re-entrenar. Son ~3 MB en total y
# se regeneran con el pipeline si hace falta. Lo pesado/crudo (01_raw,
# 02_intermediate) sigue ignorado arriba.
!data/03_primary/dataset_analitico.parquet
!data/03_primary/zonas_bogota.geojson
!models/predictivo/model.joblib
!models/clustering/clusters.joblib
!models/clustering/zona_cluster.parquet
!models/clustering/features_zona.parquet
!models/clustering/linea_base_zscore.parquet
