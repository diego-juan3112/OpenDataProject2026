# Config de entorno de la app móvil (Expo).
# Copia este archivo a `mobile/.env` y ajusta los valores.
# `mobile/.env` NO se versiona (lleva la IP de tu red). Este .example sí.
#
# Tras cambiar el .env hay que reiniciar Metro con caché limpia: npx expo start -c

# URL de la API backend: IP de LAN del PC que corre uvicorn (ipconfig -> adaptador
# Wi-Fi), o una URL de túnel ngrok. Puerto 8000. Nunca "localhost" desde el
# teléfono físico.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8000

# true = datos de prueba (mock)  ·  false = consumir la API real (entrega/demo)
EXPO_PUBLIC_USAR_MOCK=false
